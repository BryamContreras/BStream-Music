<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        layout="@layout/bstream_widget_backdrop_crossfade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <include
            layout="@layout/bstream_widget_artwork_crossfade"
            android:layout_width="50dp"
            android:layout_height="50dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:text="@string/widget_player_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_repeat"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bstream_widget_repeat"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_previous"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bstream_widget_previous"
                    android:tint="#FFFFFFFF" />

                <FrameLayout
                    android:id="@+id/widget_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_play_pause">

                    <ImageView
                        android:id="@+id/widget_play_pause_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bstream_widget_play"
                        android:tint="#FFFFFFFF" />

                    <ProgressBar
                        android:id="@+id/widget_play_pause_loading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:indeterminate="true"
                        android:indeterminateTint="#FFFFFFFF"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_next"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bstream_widget_next"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_favorite"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bstream_widget_heart_outline"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
