<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:background="@drawable/bstream_widget_background">

    <include
        layout="@layout/bstream_widget_backdrop_crossfade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/widget_metadata"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:gravity="top"
            android:orientation="horizontal">

            <include
                layout="@layout/bstream_widget_artwork_crossfade"
                android:layout_width="92dp"
                android:layout_height="92dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_player_name"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#D7DDE3E8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/widget_controls"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_repeat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/widget_previous"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/widget_previous"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bstream_widget_previous"
                        android:tint="#FFFFFFFF" />

                    <ImageView
                        android:id="@+id/widget_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/widget_play_pause"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bstream_widget_play"
                        android:tint="#FFFFFFFF" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/widget_next"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bstream_widget_next"
                        android:tint="#FFFFFFFF" />

                    <ImageView
                        android:id="@+id/widget_favorite"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_queue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="3dp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/widget_queue_title"
            android:textColor="#EFFFFFFF"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_queue_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:paddingBottom="1dp" />

            <TextView
                android:id="@+id/widget_queue_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/widget_queue_empty"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
