<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bstream_widget_background">

    <include
        layout="@layout/bstream_widget_backdrop_crossfade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <include
            layout="@layout/bstream_widget_artwork_crossfade"
            android:layout_width="72dp"
            android:layout_height="72dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_repeat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_repeat"
                    android:padding="0dp"
                    android:src="@drawable/bstream_widget_repeat"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_previous"
                    android:padding="1dp"
                    android:src="@drawable/bstream_widget_previous"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_play_pause"
                    android:padding="0dp"
                    android:src="@drawable/bstream_widget_play"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_next"
                    android:padding="0dp"
                    android:src="@drawable/bstream_widget_next"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/widget_favorite"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_favorite"
                    android:padding="1dp"
                    android:src="@drawable/bstream_widget_heart_outline"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
