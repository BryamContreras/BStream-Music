<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#945C6570"
                android:centerColor="#99394551"
                android:endColor="#A027303D" />
        </shape>
    </item>
    <!-- Opposite edges catch different colors as light passes through the rim. -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="116dp"
                android:startColor="#69ABF4FF"
                android:endColor="#00ABF4FF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="104dp"
                android:startColor="#57FCC0EF"
                android:endColor="#00FCC0EF" />
        </shape>
    </item>
    <!-- The narrow second contour gives the illuminated rim some depth. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#38223B4F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#85EFF8FF" />
        </shape>
    </item>
</layer-list>
