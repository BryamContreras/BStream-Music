+std::optional<IRect32> GaussianBlurFilterContents::CalculateDownsampleScissor(
+    const Rect& output_limit,
+    const Matrix& output_transform,
+    const ISize& texture_size,
+    const Vector2& kernel_radius) {
+  if (output_limit.IsEmpty() || !output_limit.IsFinite() ||
+      !output_transform.IsFinite() ||
+      !output_transform.IsTranslationScaleOnly() ||
+      output_transform.m[0] <= 0 || output_transform.m[5] <= 0 ||
+      !output_transform.IsInvertible() || texture_size.IsEmpty()) {
+    return std::nullopt;
+  }
+  // Inverse-map the real output clip to the original downsample texture.
+  // With separable filters the required input is the Cartesian product of
+  // both finite kernel supports. Four extra texels conservatively cover
+  // linear filtering in the two passes, final interpolation and rounding.
+  constexpr Scalar kInterpolationGuard = 4.0f;
+  Rect output = output_limit.TransformBounds(output_transform.Invert());
+  if (!output.IsFinite()) {
+    return std::nullopt;
+  }
+  const Rect full = Rect::MakeSize(texture_size);
+  // Clamp the final sampling footprint before applying the blur supports.
+  // Otherwise a clip wholly outside the texture could incorrectly exclude
+  // taps that are reached through its clamped edge texel.
+  auto visible = output.Intersection(full);
+  if (!visible.has_value()) {
+    return std::nullopt;
+  }
+  Rect required = visible->Expand(
+      kernel_radius + Vector2(kInterpolationGuard, kInterpolationGuard));
+  auto clipped = required.Intersection(full);
+  if (!clipped.has_value()) {
+    // If clamp-to-edge sampling occurs entirely off-texture, retain the
+    // original implementation instead of inferring a degenerate region.
+    return std::nullopt;
+  }
+  const auto scissor = IRect32::RoundOut(clipped.value());
+  if (scissor == IRect32::RoundOut(full)) {
+    return std::nullopt;
+  }
+  return scissor;
+}
