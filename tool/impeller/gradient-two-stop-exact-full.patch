+bool LinearGradientContents::RenderTwoStop(const ContentContext& renderer,
+                                           const Entity& entity,
+                                           RenderPass& pass) const {
+  using VS = LinearGradientTwoStopFillPipeline::VertexShader;
+  using FS = LinearGradientTwoStopFillPipeline::FragmentShader;
+
+  VS::FrameInfo frame_info;
+  frame_info.matrix = GetInverseEffectTransform();
+  PipelineBuilderCallback pipeline_callback =
+      [&renderer](ContentContextOptions options) {
+        return renderer.GetLinearGradientTwoStopFillPipeline(options);
+      };
+  return ColorSourceContents::DrawGeometry<VS>(
+      renderer, entity, pass, pipeline_callback, frame_info,
+      [this, &renderer, &entity](RenderPass& pass) {
+        FS::FragInfo frag_info;
+        frag_info.start_point = start_point_;
+        frag_info.start_to_end = end_point_ - start_point_;
+        frag_info.inverse_dot_start_to_end =
+            CalculateInverseDotStartToEnd(start_point_, end_point_);
+        frag_info.alpha =
+            GetOpacityFactor() *
+            GetGeometry()->ComputeAlphaCoverage(entity.GetTransform());
+        frag_info.end_point = end_point_;
+        frag_info.tile_mode = static_cast<Scalar>(tile_mode_);
+        frag_info.decal_border_color = decal_border_color_;
+        frag_info.colors_length = 2;
+        // The dispatch guard guarantees [0, 1]; these are the exact pairs
+        // produced by CreateGradientColors for those stops.
+        frag_info.colors[0].color = colors_[0];
+        frag_info.colors[0].stop = 0.0f;
+        frag_info.colors[0].inverse_delta = 0.0f;
+        frag_info.colors[1].color = colors_[1];
+        frag_info.colors[1].stop = 1.0f;
+        frag_info.colors[1].inverse_delta = 1.0f;
+        pass.SetCommandLabel("LinearGradientTwoStopFill");
+        FS::BindFragInfo(
+            pass, renderer.GetTransientsDataBuffer().EmplaceUniform(frag_info));
+        return true;
+      });
+}
